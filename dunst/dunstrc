# ══════════════════════════════════════════════
# DUNST — CYBERPUNK THEME
# Yellow #FFE000 / Black #0a0a0a  |  r=6
# ══════════════════════════════════════════════

[global]
    monitor  = 0
    follow   = mouse

    width    = (280, 400)
    height   = 260
    origin   = top-right
    offset   = 14x52

    progress_bar              = true
    progress_bar_height       = 8
    progress_bar_frame_width  = 1
    progress_bar_min_width    = 140
    progress_bar_max_width    = 280
    progress_bar_corner_radius = 4

    padding            = 14
    horizontal_padding = 16
    text_icon_padding  = 14
    gap_size           = 6
    separator_height   = 1
    frame_width        = 1
    corner_radius      = 6

    font        = JetBrainsMono Nerd Font 10
    line_height = 3

    markup              = full
    format              = "<b>%s</b>\n%b"
    alignment           = left
    vertical_alignment  = center
    word_wrap           = yes
    ellipsize           = middle
    stack_duplicates    = true
    show_indicators     = yes

    icon_position               = left
    min_icon_size               = 40
    max_icon_size               = 56
    icon_theme                  = Papirus-Dark
    enable_recursive_icon_lookup = true

    sticky_history  = yes
    history_length  = 20

    dmenu   = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

    mouse_left_click  = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background  = "#0f0f0f"
    foreground  = "#b8a000"
    frame_color = "#1c1c1c"
    timeout     = 4

[urgency_normal]
    background  = "#0f0f0f"
    foreground  = "#FFE000"
    frame_color = "#FFE000"
    timeout     = 7

[urgency_critical]
    background  = "#0f0f0f"
    foreground  = "#ff2244"
    frame_color = "#ff2244"
    timeout     = 0

[volume]
    summary = "Volume"
    urgency = low
    timeout = 2

[brightness]
    summary = "Brightness"
    urgency = low
    timeout = 2

[spotify]
    appname = Spotify
    urgency = low
    timeout = 5

[discord]
    appname = discord
    urgency = low
    timeout = 5
