# Minimal & Beautiful Dunst Configuration
# Place this file in ~/.config/dunst/dunstrc

[global]
    # Display
    monitor = 0
    follow = mouse
    
    # Geometry
    width = (300, 400)
    height = 300
    origin = top-right
    offset = 16x48
    
    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    # Appearance
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 16
    gap_size = 8
    separator_height = 2
    frame_width = 2
    corner_radius = 8
    
    # Typography
    font = Inter 10
    line_height = 4
    
    # Content
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    # Icons
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    
    # History
    sticky_history = yes
    history_length = 20
    
    # Misc
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    
    # Mouse
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    # Minimal gray theme
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 4
    
[urgency_normal]
    # Subtle blue accent
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8
    
[urgency_critical]
    # Attention-grabbing red
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0

# Application-specific rules
[spotify]
    appname = Spotify
    urgency = low
    timeout = 5
    
[discord]
    appname = discord
    urgency = low
    timeout = 6

[volume]
    summary = "Volume"
    urgency = low
    timeout = 2

[brightness]
    summary = "Brightness"
    urgency = low
    timeout = 2
