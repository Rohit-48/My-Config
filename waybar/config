{
  "layer": "top",
  "position": "top",
  "height": 44,
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  "modules-left": [
    "custom/nixos",
    "clock",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "custom/media"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "wlr/taskbar",
    "network",
    "pulseaudio",
    "battery"
  ],

  "custom/nixos": {
    "format": "",
    "all-outputs": true,
    "active-first": true,
    "tooltip": true,
    "tooltip-format": "{}",
    "exec": "echo NixOS $(grep '^VERSION=' /etc/os-release | cut -d= -f2 | tr -d '\"')",
    "on-click": "rofi -show drun"
  },
  "clock": {
    "timezone": "Asia/Kolkata",
    "format": "{:%a %d %H:%M}",
    "tooltip-format": "{calendar}",
    "calendar": { "mode": "month" }
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%\nCores: {cores}"
  },
  "memory": {
    "format": "{}% 󰍛",
    "tooltip": true,
    "tooltip-format": "RAM Usage: {used} / {total} ({percentage}%)"
  },
  "disk": {
    "format": "{percentage_free}% ",
    "tooltip": true,
    "tooltip-format": "Space free: {free} / {total} ({percentage_free}%)"
  },
  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "tooltip": true,
    "tooltip-format": "Temperature: {temperatureC}°C",
    "ormat-icons": [""]
  },

  "custom/media": {
  "format": "{}",
  "return-type": "json",
  "max-length": 30,
  "exec": "$HOME/.config/waybar/scripts/media.sh",
  "exec-if": "which playerctl",
  "on-click": "playerctl play-pause",
  "on-scroll-up": "playerctl next",
  "on-scroll-down": "playerctl previous",
  "interval": 2
  },


  "hyprland/workspaces": {
    "format": "{id}",
    "format-icons": {
      "default": "",
      "active": ""
    },
    "persistent-workspaces": { "*": 2 },
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": true,
    "active-first": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["rofi"]
  },
 "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈁  {ifname}",
    "format-disconnected": "󰤭  Disconnected",
    "tooltip-format": "{ifname} ({signalStrength}%)",
    "max-length": 15,
    "interval": 5,
    "on-click": "ghostty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format":          "{icon}  {capacity}%",
    "format-warning":  "{icon}  {capacity}%",
    "format-critical": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged":  "󰚥  {capacity}%",
    "format-alt":      "{icon}  {time}",
    "format-full":     "󰁹  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁"],
    "tooltip-format": "{time}"
  }
}
