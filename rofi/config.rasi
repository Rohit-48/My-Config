/**
 * CYBERPUNK ROFI THEME
 * Yellow #FFE000 on Black #0a0a0a | 6px radius everywhere
 */

configuration {
    modi:                "drun,run,window,ssh";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Win";
    display-ssh:         "󰣀 SSH";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    font:                "JetBrainsMono Nerd Font 12";

    terminal:            "ghostty";
    matching:            "fuzzy";
    scroll-method:       0;
    disable-history:     false;
    sidebar-mode:        true;

    lazy-grab:           true;
    dpi:                 96;
}

* {
    /* ── Cyberpunk palette ── */
    bg:        #0a0a0a;
    bg-panel:  #111111;
    bg-alt:    #1c1c1c;
    yellow:    #FFE000;
    yellow-d:  #b8a000;
    yellow-bg: #1a1700;     /* very dark yellow tint for selected bg */
    fg:        #FFE000;
    fg-dim:    #666666;
    red:       #ff2244;
    green:     #00ff88;

    background-color:            transparent;
    text-color:                  @fg;
    border-color:                @yellow;
    separatorcolor:              @yellow-d;
    spacing:                     0;

    normal-background:           @bg;
    normal-foreground:           @fg-dim;
    alternate-normal-background: @bg-alt;
    alternate-normal-foreground: @fg-dim;
    selected-normal-background:  @yellow-bg;
    selected-normal-foreground:  @yellow;

    active-background:           @bg;
    active-foreground:           @yellow;
    alternate-active-background: @bg-alt;
    alternate-active-foreground: @yellow;
    selected-active-background:  @yellow-bg;
    selected-active-foreground:  @yellow;

    urgent-background:           @bg;
    urgent-foreground:           @red;
    alternate-urgent-background: @bg-alt;
    alternate-urgent-foreground: @red;
    selected-urgent-background:  #2a0000;
    selected-urgent-foreground:  @red;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @yellow;
    border-radius:    6px;
    padding:          0;
    width:            46%;
}

mainbox {
    background-color: @bg;
    border:           0;
    padding:          0;
    spacing:          0;
}

inputbar {
    background-color: @bg-panel;
    text-color:       @fg;
    border:           0 0 1px 0;
    border-color:     @yellow-d;
    border-radius:    6px 6px 0 0;
    padding:          14px 18px;
    spacing:          10px;
    children:         [ "prompt", "textbox-prompt-colon", "entry", "case-indicator" ];
}

prompt {
    background-color: transparent;
    text-color:       @yellow;
    font:             "JetBrainsMono Nerd Font Bold 13";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @yellow-d;
    expand:           false;
    str:              "󰍉";
    margin:           0 6px 0 0;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "search...";
    placeholder-color: @fg-dim;
    cursor:           text;
}

case-indicator {
    background-color: transparent;
    text-color:       @fg-dim;
}

listview {
    background-color: @bg;
    border:           0;
    padding:          8px;
    spacing:          2px;
    scrollbar:        true;
    lines:            9;
    cycle:            true;
    dynamic:          true;
    fixed-height:     true;
}

scrollbar {
    background-color: @bg-alt;
    handle-color:     @yellow-d;
    handle-width:     4px;
    border:           0;
    border-radius:    6px;
    margin:           0 0 0 6px;
}

element {
    background-color: transparent;
    text-color:       @fg-dim;
    border:           0;
    border-radius:    6px;
    padding:          9px 12px;
    spacing:          10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-dim;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg-dim;
}

element selected.normal {
    background-color: @yellow-bg;
    text-color:       @yellow;
    border:           1px;
    border-color:     @yellow-d;
    border-radius:    6px;
}

element normal.active    { text-color: @yellow; }
element selected.active  { background-color: @yellow-bg; text-color: @yellow; border-radius: 6px; }
element normal.urgent    { text-color: @red; }
element selected.urgent  { background-color: #2a0000; text-color: @red; border-radius: 6px; }

element-icon {
    background-color: transparent;
    size:             28px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           pointer;
    vertical-align:   0.5;
}

mode-switcher {
    background-color: @bg-panel;
    border:           1px 0 0 0;
    border-color:     @yellow-d;
    border-radius:    0 0 6px 6px;
    padding:          8px;
    spacing:          8px;
}

button {
    background-color: transparent;
    text-color:       @fg-dim;
    border-radius:    6px;
    padding:          8px 16px;
    cursor:           pointer;
}

button selected {
    background-color: @yellow-bg;
    text-color:       @yellow;
    border:           1px;
    border-color:     @yellow-d;
}

message {
    background-color: @bg-panel;
    border:           1px 0 0 0;
    border-color:     @yellow-d;
    padding:          12px;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
}

error-message {
    background-color: @bg;
    border:           2px;
    border-color:     @red;
    border-radius:    6px;
    padding:          20px;
}
