configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "";
    display-run:         "";
    display-window:      "";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    font:                "JetBrainsMono Nerd Font 13";
    terminal:            "ghostty";
    matching:            "fuzzy";
    scroll-method:       0;
    disable-history:     false;
    sidebar-mode:        false;
    lazy-grab:           true;
    dpi:                 96;
}

* {
    bg:       #0e1016;
    bg-alt:   #1c2030;
    bg-high:  #2e3650;
    fg:       #c8d4e8;
    fg-alt:   #4a5260;
    accent:   #b85c2a;
    urgent:   #e05a3a;

    background-color:            transparent;
    text-color:                  @fg;
    border-color:                @accent;
    separatorcolor:              @bg-alt;
    spacing:                     0;

    normal-background:           transparent;
    normal-foreground:           @fg;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @fg-alt;
    selected-normal-background:  @bg-high;
    selected-normal-foreground:  @fg;

    active-background:           transparent;
    active-foreground:           @accent;
    alternate-active-background: transparent;
    alternate-active-foreground: @accent;
    selected-active-background:  @accent;
    selected-active-foreground:  @bg;

    urgent-background:           transparent;
    urgent-foreground:           @urgent;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: @urgent;
    selected-urgent-background:  @urgent;
    selected-urgent-foreground:  @bg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    5px;
    padding:          0;
    width:            40%;
}

mainbox {
    background-color: transparent;
    border:           0;
    padding:          0;
    spacing:          0;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           0 0 1px 0;
    border-color:     @accent;
    border-radius:    5px 5px 0 0;
    padding:          14px 16px;
    spacing:          10px;
    children:         [ "prompt", "textbox-prompt-colon", "entry" ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 13";
}

textbox-prompt-colon {
    background-color: transparent;
    text-color:       @fg-alt;
    expand:           false;
    str:              "·";
    margin:           0 6px 0 0;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "search...";
    placeholder-color: @fg-alt;
    cursor:            text;
}

listview {
    background-color: @bg;
    border:           0;
    padding:          8px;
    spacing:          2px;
    scrollbar:        false;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    fixed-height:     true;
    border-radius:    0 0 5px 5px;
}

element {
    background-color: transparent;
    text-color:       @fg;
    border:           0;
    border-radius:    4px;
    padding:          8px 10px;
    spacing:          10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:       @accent;
}

element selected.normal {
    background-color: @bg-high;
    text-color:       @fg;
    border:           0 0 0 2px;
    border-color:     @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element selected.active {
    background-color: @accent;
    text-color:       @bg;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg-alt;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element alternate.active {
    background-color: transparent;
    text-color:       @accent;
}

element-icon {
    background-color: transparent;
    size:             28px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           pointer;
    vertical-align:   0.5;
}

error-message {
    background-color: @bg;
    border:           1px;
    border-color:     @urgent;
    border-radius:    5px;
    padding:          20px;
    text-color:       @fg;
}
